[Unit]
Description=ROKAE right RealSense native ROS RGB-D
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/vision
EnvironmentFile=/home/admin/vision/config/ros/ros.env
Environment=PYTHONNOUSERSITE=1
ExecStart=/bin/bash -c 'source /home/admin/vision/config/ros/setup.bash && exec /usr/bin/python3 -m vision.rokae_runtime.driver_supervisor --config /home/admin/vision/config/vision.json --camera hand_right'
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
